# Copy to .env for local dev. Server-side only — nothing here is shipped to a browser.
APP_ENV=local
PORT=8080
# Interface to listen on. Loopback by default so nobody on shared Wi-Fi can use your AI budget.
# Containers / servers behind a proxy: HOST=0.0.0.0
HOST=127.0.0.1

# Rights Intelligence (Nebius Token Factory, OpenAI-compatible API)
# Leave NEBIUS_API_KEY empty to run with AI disabled (deterministic engine still works).
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Models are routed per task from agent/etc/models.json (light / standard / heavy).
# Re-pick the cheapest passing models with: npm run models:route  (add -- --write to save)
# AI_MODEL_ROUTING=off sends every call to NEBIUS_MODEL instead (debugging only).
AI_MODEL_ROUTING=auto
NEBIUS_MODEL=
NEBIUS_API_KEY=
AI_TIMEOUT_MS=20000
# Reasoning per phase comes from agent/etc/agent.json (fast path off, deep "plan" path low).
# off = force reasoning off everywhere (cost kill switch). auto = follow agent/etc/agent.json.
AI_REASONING=auto
# Global cap on model calls per UTC day (cost protection; /analyze has no auth). 0 = unlimited (dev only).
AI_DAILY_CALL_LIMIT=300
# Global cap on BILLED model tokens per UTC day (prompt + completion, reasoning included).
# Protects a small credit balance: ~150k/day ≈ 400+ checks. 0 = unlimited (dev only).
AI_DAILY_TOKEN_BUDGET=150000
# Global cap on model SPEND per UTC day in USD, priced per tier from agent/etc/models.json.
# $0.25/day lasts 80 days on a $20 credit. 0 = unlimited (dev only).
AI_DAILY_BUDGET_USD=0.25
# Per-client cap on /analyze requests per UTC day (keyed like the rate limiter). 0 = unlimited.
AI_PER_CLIENT_DAILY_CALLS=40

# Browser origins allowed to call the API in production (comma-separated). Dev uses the Vite proxy.
CORS_ORIGINS=

# How the API finds the real client IP for rate limiting:
#   none               direct exposure (default; forwarding headers ignored)
#   cloudflare         behind Cloudflare proxy: only Cloudflare IP ranges accepted, keyed on CF-Connecting-IP
#   cloudflare-tunnel  behind cloudflared on this host: only loopback accepted, keyed on CF-Connecting-IP
TRUST_PROXY=none

# Decision receipt signing key (Ed25519, 32-byte seed as hex). From a secret manager in production.
# Generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
# Empty outside production = temporary dev key (receipts stop verifying on restart). Required when APP_ENV=production.
RECEIPT_SIGNING_KEY=
# After rotating, list old PUBLIC keys (hex, comma-separated) so old receipts still verify.
RECEIPT_RETIRED_PUBLIC_KEYS=

# Midnight — NOT USED until the Saturday wallet/token milestone. Keep empty.
MIDNIGHT_NETWORK=preview
MIDNIGHT_INDEXER_URL=
MIDNIGHT_PROOF_SERVER_URL=
