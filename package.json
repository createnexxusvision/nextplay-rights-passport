    "eval": "npm run eval -w @nextplay/api",
    "models": "npm run models -w @nextplay/api"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.3"
  }
}
